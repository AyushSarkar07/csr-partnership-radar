# CSR Partnership Radar — environment variables (names only; never commit real values)
# Copy to .env.local for local development. On Vercel set them in Project → Settings → Environment Variables.

# --- Database (required) -----------------------------------------------------
# Postgres connection string. Provisioned automatically by the Vercel ↔ Neon integration.
DATABASE_URL=
# Optional direct (non-pooled) connection used by CLI scripts (migrate/seed).
DATABASE_URL_UNPOOLED=

# --- Gemini Flash (required for AI analysis) ----------------------------------
# Server-side only. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Must be a Gemini *Flash* model id (the app refuses anything else). Default: gemini-3.8-flash
GEMINI_MODEL=gemini-3.8-flash
# Max Gemini classifications per refresh run (cost + function-duration guard). Default 16.
MAX_AI_PER_RUN=16

# --- Scheduled job protection (required for the Monday cron) -----------------
# Random string ≥ 16 chars. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# --- Public URL (used for links in emailed digests) ----------------------------
APP_URL=https://your-deployment.vercel.app

# --- Optional email delivery (Resend) -----------------------------------------
# If unset, digests are stored in the app (printable) and delivery status shows "not configured".
RESEND_API_KEY=
# Verified sender, e.g. "CSR Radar <radar@yourdomain.org>"
DIGEST_FROM_EMAIL=
# Recipient and on/off switch are configured in the app's Settings page.
